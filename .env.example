QWEN_API_KEY=
# standard: 百炼通用接口；token-plan: 套餐专用接口
QWEN_ACCESS_MODE=standard
QWEN_CHAT_MODEL=qwen-plus
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_VOICE=Cherry
# 长期使用实时语音需标准按量付费密钥和对应业务空间 ID；单人测试可显式启用下方测试开关。
QWEN_REALTIME_API_KEY=
QWEN_REALTIME_WORKSPACE_ID=
QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
# 仅供本人显式测试套餐实时端点；正常站点保持为空。
QWEN_REALTIME_TEST_MODE=
